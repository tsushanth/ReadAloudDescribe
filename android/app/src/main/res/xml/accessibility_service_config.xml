<?xml version="1.0" encoding="utf-8"?>
<!--
    This is a screen reader for people who are blind or have low vision,
    so it declares isAccessibilityTool (read on Android 12+, ignored
    before). canTakeScreenshot backs the "describe screen" gesture.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFeedbackType="feedbackSpoken"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagRequestTouchExplorationMode|flagRequestFilterKeyEvents"
    android:isAccessibilityTool="true"
    android:canRetrieveWindowContent="true"
    android:canRequestTouchExplorationMode="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:notificationTimeout="0"
    android:description="@string/accessibility_service_description"
    android:settingsActivity="com.listenai.describe.DescribeActivity" />
